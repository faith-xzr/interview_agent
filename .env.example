DATA_DIR=data
DATABASE_PATH=data/recruiting_demo.sqlite3
VECTOR_DIR=data/vectors

# DashScope / 通义千问
AI_BAILIAN_API_KEY=
AI_MODEL=qwen3.5-flash

# DeepSeek
PROVIDER_DEEPSEEK_API_KEY=
PROVIDER_DEEPSEEK_MODEL=deepseek-v4-flash

# Moonshot / Kimi
PROVIDER_KIMI_API_KEY=
PROVIDER_KIMI_MODEL=kimi-latest

# 智谱 GLM
PROVIDER_GLM_API_KEY=
PROVIDER_GLM_MODEL=glm-5

# Optional custom OpenAI-compatible provider.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
ENABLE_CHROMA=true
